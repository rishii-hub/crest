<?xml version="1.0" encoding="utf-8"?>
<!--
  Optional MSIX package for Crest. The only reason to use it: package identity, which Windows
  requires before an app may read your notifications (UserNotificationListener). That powers
  "Mirror notifications & calls". Everything else works the same in the plain .exe.
  Build with packaging\build-msix.ps1 (see packaging\README.md). Publisher must match your signing certificate.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 rescap">

  <Identity Name="Crest.Notch" Publisher="CN=Crest Dev" Version="1.7.0.0" ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Crest</DisplayName>
    <PublisherDisplayName>Crest contributors</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="Crest" Executable="Crest.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements DisplayName="Crest" Description="Dynamic Island for Windows"
                          BackgroundColor="transparent" Square150x150Logo="Assets\Square150x150Logo.png" Square44x44Logo="Assets\Square44x44Logo.png" />
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <uap3:Capability Name="userNotificationListener" />
  </Capabilities>
</Package>

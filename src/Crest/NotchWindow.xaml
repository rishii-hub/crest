<Window x:Class="Crest.NotchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Crest.Controls"
        Title="Crest"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        AllowDrop="True"
        Left="-20000" Top="-20000" Width="400" Height="100"
        FontFamily="{DynamicResource UiFont}"
        Foreground="{DynamicResource TextBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        Stylus.IsFlicksEnabled="False">

  <Grid x:Name="Root">

    <!-- Invisible (alpha 1) strip so the thin "line" look is still easy to hover. -->
    <Border x:Name="HoverZone" Background="#01000000" HorizontalAlignment="Center" VerticalAlignment="Top" Width="200" Height="10"/>

    <!-- Split-pill bubble: the second live activity, as a separate island beside the notch -->
    <Grid x:Name="Bubble" HorizontalAlignment="Center" VerticalAlignment="Top" Width="32" Height="32" Visibility="Collapsed"
          RenderTransformOrigin="0.5,0.5" Cursor="Hand" Stylus.IsPressAndHoldEnabled="False">
      <Grid.RenderTransform>
        <TransformGroup>
          <ScaleTransform x:Name="BubbleScale" ScaleX="0.3" ScaleY="0.3"/>
          <TranslateTransform x:Name="BubbleX"/>
          <TranslateTransform x:Name="BubbleDrag"/>
        </TransformGroup>
      </Grid.RenderTransform>
      <Ellipse x:Name="BubbleBg" Fill="Black"/>
      <Ellipse x:Name="BubbleArt" Margin="4" Visibility="Collapsed"/>
      <c:RingProgress x:Name="BubbleRing" Margin="3" Thickness="2.5" Visibility="Collapsed" RingBrush="{DynamicResource AccentBrush}"/>
      <TextBlock x:Name="BubbleGlyph" Style="{StaticResource Icon}" FontSize="13" Foreground="{DynamicResource AccentBrush}"/>
    </Grid>

    <!-- The shadow lives on this unclipped wrapper: on the clipped notch itself it got cut off at the
         notch's bounding box and showed up as grey corners. -->
    <Grid x:Name="NotchHost">
    <Grid x:Name="Notch" HorizontalAlignment="Center" VerticalAlignment="Top" Width="208" Height="32" ClipToBounds="True"
          Stylus.IsPressAndHoldEnabled="False">
      <Grid.RenderTransform>
        <TranslateTransform x:Name="NotchShift"/>
      </Grid.RenderTransform>
      <c:NotchShape x:Name="Shape" Fill="Black"/>
      <c:Backdrop x:Name="BackdropLayer" Opacity="0" Visibility="Collapsed"/>

      <!-- ===== Collapsed: live activities ===== -->
      <Grid x:Name="CollapsedLayer" VerticalAlignment="Top" TextElement.Foreground="White">
        <Grid x:Name="ActivityRow" Height="32" VerticalAlignment="Top">

          <!-- current lyric line while music plays (optional) -->
          <TextBlock x:Name="LyricLine" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"
                     TextTrimming="CharacterEllipsis" Visibility="Collapsed" Opacity="0.95">
            <TextBlock.RenderTransform><TranslateTransform x:Name="LyricShift"/></TextBlock.RenderTransform>
          </TextBlock>
          <c:NotchEyes x:Name="Eyes" HorizontalAlignment="Center" VerticalAlignment="Center" Width="50" Height="16" Visibility="Collapsed"/>

          <!-- left slot -->
          <Grid x:Name="LeftSlot" HorizontalAlignment="Left" VerticalAlignment="Center">
            <Border x:Name="MediaArt" Width="22" Height="22" CornerRadius="6" Background="#FF2C2C2E" Visibility="Collapsed">
              <TextBlock x:Name="MediaArtGlyph" Style="{StaticResource Icon}" Text="&#xE8D6;" FontSize="11" Foreground="{DynamicResource AccentBrush}"/>
            </Border>
            <StackPanel x:Name="LeftLabel" Orientation="Horizontal" Visibility="Collapsed">
              <TextBlock x:Name="LeftGlyph" Style="{StaticResource Icon}" FontSize="14" Text="&#xE916;"/>
              <TextBlock x:Name="LeftText" Margin="7,0,0,0" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis" MaxWidth="170"/>
            </StackPanel>
          </Grid>

          <!-- right slot -->
          <StackPanel x:Name="RightSlot" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <StackPanel x:Name="Equalizer" Orientation="Horizontal" VerticalAlignment="Center" Height="16" Visibility="Collapsed">
              <Rectangle x:Name="Bar0" Width="3" Height="5" RadiusX="1.5" RadiusY="1.5" Margin="0,0,2.5,0" VerticalAlignment="Center"/>
              <Rectangle x:Name="Bar1" Width="3" Height="9" RadiusX="1.5" RadiusY="1.5" Margin="0,0,2.5,0" VerticalAlignment="Center"/>
              <Rectangle x:Name="Bar2" Width="3" Height="12" RadiusX="1.5" RadiusY="1.5" Margin="0,0,2.5,0" VerticalAlignment="Center"/>
              <Rectangle x:Name="Bar3" Width="3" Height="7" RadiusX="1.5" RadiusY="1.5" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock x:Name="RightText" Style="{StaticResource Num}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Visibility="Collapsed"/>
            <c:BatteryGlyph x:Name="RightBattery" Margin="7,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
            <StackPanel x:Name="ActionPanel" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0" Visibility="Collapsed"/>
            <StackPanel x:Name="PrivacyDots" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0" Visibility="Collapsed">
              <Ellipse x:Name="CamDot" Width="6" Height="6" Fill="{DynamicResource GreenBrush}" Margin="0,0,3,0" Visibility="Collapsed"/>
              <Ellipse x:Name="MicDot" Width="6" Height="6" Fill="{DynamicResource OrangeBrush}" Visibility="Collapsed"/>
            </StackPanel>
          </StackPanel>
        </Grid>

        <!-- HUD bar (volume / brightness) -->
        <Grid x:Name="HudBar" VerticalAlignment="Top" Height="5" Visibility="Collapsed">
          <Border CornerRadius="2.5" Background="#33FFFFFF"/>
          <Border x:Name="HudFill" CornerRadius="2.5" Background="White" RenderTransformOrigin="0,0.5">
            <Border.RenderTransform>
              <ScaleTransform x:Name="HudScale" ScaleX="0.5"/>
            </Border.RenderTransform>
          </Border>
        </Grid>
      </Grid>

      <!-- ===== Expanded ===== -->
      <!-- clipped to the island's silhouette, so content is revealed by the shape as it grows and never spills past it -->
      <Grid x:Name="ExpandedClip">
      <Grid x:Name="ExpandedLayer" HorizontalAlignment="Center" VerticalAlignment="Top" Visibility="Collapsed" Opacity="0">
        <Grid.RenderTransform>
          <TranslateTransform x:Name="ExpandedShift" Y="-10"/>
        </Grid.RenderTransform>
        <Grid.RowDefinitions>
          <RowDefinition Height="26"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- header: a tiny page switcher on the left, privacy dots · pin · open app on the right. That's all. -->
        <DockPanel LastChildFill="True">
          <StackPanel x:Name="HeaderRight" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
            <StackPanel x:Name="HeaderPrivacy" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0" Visibility="Collapsed">
              <Ellipse x:Name="HeaderCamDot" Width="6" Height="6" Fill="{DynamicResource GreenBrush}" Margin="0,0,4,0" Visibility="Collapsed"/>
              <Ellipse x:Name="HeaderMicDot" Width="6" Height="6" Fill="{DynamicResource OrangeBrush}" Visibility="Collapsed"/>
            </StackPanel>
            <ToggleButton x:Name="PinButton" Style="{StaticResource IconToggle}" Content="&#xE718;" FontSize="11" Width="26" Height="26" ToolTip="Keep open"/>
            <Button x:Name="AppButton" Style="{StaticResource IconButton}" Content="&#xE8A9;" FontSize="12" Width="26" Height="26" ToolTip="Open Crest: every feature and setting"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left">
            <Border x:Name="DockBorder" Background="Transparent" CornerRadius="13" VerticalAlignment="Center">
              <Grid>
                <Canvas x:Name="PillCanvas" IsHitTestVisible="False">
                  <Border x:Name="DockPill" Width="26" Height="26" CornerRadius="13" Background="{DynamicResource InkBrush}" RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform>
                      <TransformGroup>
                        <ScaleTransform x:Name="PillScale"/>
                        <TranslateTransform x:Name="PillX"/>
                      </TransformGroup>
                    </Border.RenderTransform>
                  </Border>
                </Canvas>
                <StackPanel x:Name="TabBar" Orientation="Horizontal"/>
              </Grid>
            </Border>
            <Border x:Name="Banner" VerticalAlignment="Center" Opacity="0" IsHitTestVisible="False" Margin="10,0,0,0"
                    Background="{DynamicResource Card2Brush}" CornerRadius="11" Padding="9,3">
              <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="BannerGlyph" Style="{StaticResource Icon}" FontSize="11" Margin="0,0,6,0"/>
                <TextBlock x:Name="BannerText" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
              </StackPanel>
            </Border>
          </StackPanel>
          <!-- empty middle: grab it and pull down to pop the page out as a floating widget -->
          <Border x:Name="HeaderLeft" Background="Transparent" Cursor="SizeAll"/>
        </DockPanel>

        <Grid Grid.Row="1" Margin="0,6,0,4" ClipToBounds="True">
          <ContentControl x:Name="TabHost" Focusable="False">
            <ContentControl.RenderTransform>
              <TranslateTransform x:Name="TabShift"/>
            </ContentControl.RenderTransform>
          </ContentControl>
        </Grid>
      </Grid>
      </Grid>
    </Grid>
    </Grid>
  </Grid>
</Window>

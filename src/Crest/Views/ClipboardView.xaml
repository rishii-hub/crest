<UserControl x:Class="Crest.Views.ClipboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <DockPanel Margin="0,0,0,8">
      <Button x:Name="ClearBtn" DockPanel.Dock="Right" Style="{StaticResource Pill}" Content="Clear unpinned" Margin="8,0,0,0"/>
      <TextBlock x:Name="CountText" DockPanel.Dock="Right" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="10,0,0,0"/>
      <TextBox x:Name="SearchBox" Style="{StaticResource Field}" Tag="Search clipboard history…"/>
    </DockPanel>

    <Grid Grid.Row="1">
      <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
        <TextBlock Style="{StaticResource Icon}" Text="&#xE77F;" FontSize="28" Foreground="{StaticResource Text3Brush}"/>
        <TextBlock x:Name="EmptyTitle" Text="Copy something — it shows up here" FontSize="13.5" Margin="0,10,0,2" HorizontalAlignment="Center"/>
        <TextBlock x:Name="EmptySub" Style="{StaticResource Caption}" HorizontalAlignment="Center"
                   Text="Text, images and files. Click an entry to copy it again. Pin the ones you reuse."/>
      </StackPanel>

      <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <ItemsControl x:Name="List">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid x:Name="Row" Margin="0,0,6,6" Background="Transparent" Cursor="Hand" MouseLeftButtonUp="OnRowClick">
                <Border x:Name="Bg" CornerRadius="12" Background="{StaticResource CardBrush}"/>
                <Grid Margin="10,8,8,8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <Border Width="36" Height="36" CornerRadius="8" Background="{StaticResource Card2Brush}" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <Grid>
                      <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="14" Foreground="{StaticResource Text2Brush}"/>
                      <Border CornerRadius="8">
                        <Border.Background>
                          <ImageBrush ImageSource="{Binding Thumb}" Stretch="UniformToFill"/>
                        </Border.Background>
                      </Border>
                    </Grid>
                  </Border>
                  <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Preview}" FontSize="12.5" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" MaxHeight="36"/>
                    <TextBlock Text="{Binding Subtitle}" FontSize="10.5" Foreground="{StaticResource Text3Brush}" Margin="0,2,0,0"/>
                  </StackPanel>
                  <StackPanel x:Name="Actions" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Opacity="0.0">
                    <Button Style="{StaticResource IconButton}" Content="{Binding PinGlyph}" Width="28" Height="28" FontSize="12" ToolTip="Pin" Click="OnPin"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE74D;" Width="28" Height="28" FontSize="12" ToolTip="Delete" Click="OnDelete"/>
                  </StackPanel>
                  <TextBlock x:Name="PinMark" Grid.Column="2" Style="{StaticResource Icon}" Text="&#xE840;" FontSize="11"
                             Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right" Visibility="Collapsed" Margin="0,0,4,0"/>
                </Grid>
              </Grid>
              <DataTemplate.Triggers>
                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                  <Setter TargetName="Bg" Property="Background" Value="{StaticResource Card2Brush}"/>
                  <Setter TargetName="Actions" Property="Opacity" Value="1"/>
                  <Setter TargetName="PinMark" Property="Opacity" Value="0"/>
                </Trigger>
                <DataTrigger Binding="{Binding Pinned}" Value="True">
                  <Setter TargetName="PinMark" Property="Visibility" Value="Visible"/>
                </DataTrigger>
              </DataTemplate.Triggers>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Grid>
  </Grid>
</UserControl>

<UserControl x:Class="Crest.Views.ClipboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <Style x:Key="ClipRow" TargetType="ListBoxItem">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="0,0,6,4"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Grid>
              <Border x:Name="Bg" CornerRadius="11" Background="Transparent"/>
              <Border x:Name="Bar" Width="3" CornerRadius="1.5" HorizontalAlignment="Left" Margin="0,9" Background="{DynamicResource AccentBrush}" Opacity="0"/>
              <ContentPresenter Margin="8,6,6,6"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="#FF1E1E20"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="{StaticResource Card2Brush}"/>
                <Setter TargetName="Bar" Property="Opacity" Value="1"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <DockPanel Margin="0,0,0,8">
      <Button x:Name="ClearBtn" DockPanel.Dock="Right" Style="{StaticResource Pill}" Content="Clear unpinned" Margin="8,0,0,0"/>
      <TextBox x:Name="SearchBox" DockPanel.Dock="Right" Style="{StaticResource Field}" Tag="Search…" Width="190" Padding="10,5"/>
      <Border Background="{StaticResource CardBrush}" CornerRadius="10" Padding="2" HorizontalAlignment="Left">
        <StackPanel x:Name="Filters" Orientation="Horizontal"/>
      </Border>
    </DockPanel>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1.05*"/>
        <ColumnDefinition Width="10"/>
        <ColumnDefinition Width="1*"/>
      </Grid.ColumnDefinitions>

      <StackPanel x:Name="EmptyState" Grid.ColumnSpan="3" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
        <TextBlock Style="{StaticResource Icon}" Text="&#xE77F;" FontSize="28" Foreground="{StaticResource Text3Brush}"/>
        <TextBlock x:Name="EmptyTitle" Text="Copy something — it shows up here" FontSize="13.5" Margin="0,10,0,2" HorizontalAlignment="Center"/>
        <TextBlock x:Name="EmptySub" Style="{StaticResource Caption}" HorizontalAlignment="Center"
                   Text="Text, images and files. Double-click an entry to copy it again. Pin the ones you reuse."/>
      </StackPanel>

      <ListBox x:Name="List" Background="Transparent" BorderThickness="0" Padding="0" ItemContainerStyle="{StaticResource ClipRow}"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="34"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <Border Width="30" Height="30" CornerRadius="7" Background="{StaticResource CardBrush}" VerticalAlignment="Center" HorizontalAlignment="Left">
                <Grid>
                  <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="12" Foreground="{StaticResource Text2Brush}"/>
                  <Border CornerRadius="7">
                    <Border.Background>
                      <ImageBrush ImageSource="{Binding Thumb}" Stretch="UniformToFill"/>
                    </Border.Background>
                  </Border>
                </Grid>
              </Border>
              <StackPanel Grid.Column="1" Margin="8,0,4,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Preview}" FontSize="12.5" TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextBrush}"/>
                <TextBlock Text="{Binding Subtitle}" FontSize="10.5" Foreground="{StaticResource Text3Brush}" Margin="0,1,0,0"/>
              </StackPanel>
              <TextBlock x:Name="PinMark" Grid.Column="2" Style="{StaticResource Icon}" Text="&#xE840;" FontSize="10"
                         Foreground="{DynamicResource AccentBrush}" Visibility="Collapsed" Margin="0,0,2,0"/>
            </Grid>
            <DataTemplate.Triggers>
              <DataTrigger Binding="{Binding Pinned}" Value="True">
                <Setter TargetName="PinMark" Property="Visibility" Value="Visible"/>
              </DataTrigger>
            </DataTemplate.Triggers>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <Border x:Name="PreviewCard" Grid.Column="2" Style="{StaticResource Card}" Padding="14,10">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <DockPanel>
            <Button x:Name="DeleteBtn" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE74D;" Width="26" Height="26" FontSize="11" ToolTip="Delete"/>
            <Button x:Name="PinBtn" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE718;" Width="26" Height="26" FontSize="11" ToolTip="Pin / unpin"/>
            <TextBlock x:Name="PreviewKind" FontSize="11" Foreground="{StaticResource Text3Brush}" VerticalAlignment="Center"/>
          </DockPanel>
          <ScrollViewer Grid.Row="1" Margin="0,6,0,6" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid>
              <TextBlock x:Name="PreviewText" FontSize="12.5" TextWrapping="Wrap" LineHeight="18"/>
              <Image x:Name="PreviewImage" Stretch="Uniform" MaxHeight="200" HorizontalAlignment="Left"/>
            </Grid>
          </ScrollViewer>
          <DockPanel Grid.Row="2">
            <Button x:Name="CopyBtn" DockPanel.Dock="Right" Style="{StaticResource Pill}" Foreground="Black" Background="{DynamicResource AccentBrush}" Padding="14,5">
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE8C8;" FontSize="11" Margin="0,0,6,0"/>
                <TextBlock Text="Copy" FontWeight="SemiBold"/>
              </StackPanel>
            </Button>
            <TextBlock x:Name="PreviewStats" FontSize="11" Foreground="{StaticResource Text3Brush}" VerticalAlignment="Center"/>
          </DockPanel>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>

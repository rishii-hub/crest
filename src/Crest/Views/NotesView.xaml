<UserControl x:Class="Crest.Views.NotesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="1.15*"/>
      <ColumnDefinition Width="12"/>
      <ColumnDefinition Width="1*"/>
    </Grid.ColumnDefinitions>

    <Border Style="{StaticResource Card}" Padding="14,12">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,8">
          <Button x:Name="CopyNote" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE8C8;" Width="26" Height="26" FontSize="11" ToolTip="Copy note"/>
          <TextBlock x:Name="WordCount" DockPanel.Dock="Right" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <TextBlock Text="Notes" Style="{StaticResource H1}"/>
        </DockPanel>
        <TextBox x:Name="NoteBox" Grid.Row="1" Style="{StaticResource Field}" Background="Transparent" Padding="0"
                 AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                 VerticalContentAlignment="Top" Tag="Jot something down. Saved automatically."/>
      </Grid>
    </Border>

    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="14,12">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,8">
          <Button x:Name="ClearDone" DockPanel.Dock="Right" Style="{StaticResource Pill}" Padding="8,3" FontSize="11" Content="Clear done"/>
          <TextBlock x:Name="TodoCount" DockPanel.Dock="Right" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <TextBlock Text="To-do" Style="{StaticResource H1}"/>
        </DockPanel>
        <TextBox x:Name="NewTodo" Grid.Row="1" Style="{StaticResource Field}" Tag="Add a task and press Enter" Margin="0,0,0,8"/>
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
          <ItemsControl x:Name="Todos">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid x:Name="Row" Background="Transparent" Margin="0,0,4,2">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="26"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <CheckBox Style="{StaticResource Check}" IsChecked="{Binding Done, Mode=TwoWay}" Click="OnToggle"/>
                  <TextBlock x:Name="Label" Grid.Column="1" Text="{Binding Text}" FontSize="12.5" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,5"/>
                  <Button x:Name="Del" Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE711;" Width="22" Height="22" FontSize="9"
                          Opacity="0" Click="OnDelete"/>
                </Grid>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding Done}" Value="True">
                    <Setter TargetName="Label" Property="TextDecorations" Value="Strikethrough"/>
                    <Setter TargetName="Label" Property="Foreground" Value="{StaticResource Text3Brush}"/>
                  </DataTrigger>
                  <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Del" Property="Opacity" Value="1"/>
                  </Trigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
    </Border>
  </Grid>
</UserControl>

<UserControl x:Class="Crest.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Crest.Controls">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="1.25*"/>
      <ColumnDefinition Width="12"/>
      <ColumnDefinition Width="1*"/>
    </Grid.ColumnDefinitions>

    <!-- Now playing -->
    <Border Style="{StaticResource Card}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Grid Width="104" Height="104">
            <Border x:Name="ArtGlow" CornerRadius="16" Opacity="0.55" Margin="6,10,6,0">
              <Border.Effect>
                <BlurEffect Radius="18"/>
              </Border.Effect>
            </Border>
            <Border x:Name="ArtBox" CornerRadius="16" Background="{DynamicResource Card2Brush}">
              <TextBlock x:Name="ArtPlaceholder" Style="{StaticResource Icon}" Text="&#xE8D6;" FontSize="34" Foreground="{DynamicResource Text3Brush}"/>
            </Border>
          </Grid>
          <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
            <TextBlock x:Name="AppText" FontSize="11" Foreground="{DynamicResource Text3Brush}" Text="NOW PLAYING"/>
            <TextBlock x:Name="TitleText" FontSize="18" FontWeight="SemiBold" FontFamily="{DynamicResource DisplayFont}"
                       TextTrimming="CharacterEllipsis" Margin="0,4,0,0" Text="Nothing playing"/>
            <TextBlock x:Name="ArtistText" FontSize="13" Foreground="{DynamicResource Text2Brush}" TextTrimming="CharacterEllipsis"
                       Margin="0,3,0,0" Text="Play something in Spotify, a browser or any media app"/>
          </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,8,0,0">
          <c:SpectrumBars x:Name="Spectrum" Height="34" VerticalAlignment="Center" Margin="0,0,110,0"/>
          <Button x:Name="OutputBtn" Style="{StaticResource Pill}" HorizontalAlignment="Right" VerticalAlignment="Center"
                  Padding="9,3" FontSize="11" MaxWidth="104" ToolTip="Click to switch audio output">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource Icon}" Text="&#xE7F5;" FontSize="11" Margin="0,0,5,0"/>
              <TextBlock x:Name="OutputText" Text="Output" TextTrimming="CharacterEllipsis" MaxWidth="72"/>
            </StackPanel>
          </Button>
        </Grid>

        <Grid x:Name="SeekRow" Grid.Row="2" Margin="0,8,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="40"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="40"/>
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="PosText" Style="{StaticResource Num}" FontSize="11" Foreground="{DynamicResource Text3Brush}" VerticalAlignment="Center" Text="0:00"/>
          <Slider x:Name="SeekSlider" Grid.Column="1" Style="{StaticResource Thin}" Minimum="0" Maximum="1" Margin="4,0"/>
          <TextBlock x:Name="DurText" Grid.Column="2" Style="{StaticResource Num}" FontSize="11" Foreground="{DynamicResource Text3Brush}"
                     VerticalAlignment="Center" HorizontalAlignment="Right" Text="0:00"/>
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
          <Button x:Name="PrevBtn" Style="{StaticResource IconButton}" Width="42" Height="42" FontSize="17" Content="&#xE892;"/>
          <Button x:Name="PlayBtn" Style="{StaticResource PrimaryButton}" Margin="14,0" Content="&#xE768;"/>
          <Button x:Name="NextBtn" Style="{StaticResource IconButton}" Width="42" Height="42" FontSize="17" Content="&#xE893;"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Right column: clock/weather, widgets, controls -->
    <Grid Grid.Column="2">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <Grid Margin="4,0,4,6">
        <StackPanel>
          <TextBlock x:Name="ClockText" FontFamily="{DynamicResource DisplayFont}" FontSize="34" FontWeight="Light" Text="00:00"
                     Typography.NumeralAlignment="Tabular"/>
          <TextBlock x:Name="DateText" FontSize="12" Foreground="{DynamicResource Text2Brush}" Margin="1,-3,0,0"/>
        </StackPanel>
        <Button x:Name="WeatherMini" Style="{StaticResource Pill}" Background="Transparent" HorizontalAlignment="Right" VerticalAlignment="Top"
                Padding="8,2" ToolTip="Weather">
          <StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <TextBlock x:Name="WeatherSymbol" FontFamily="{StaticResource EmojiFont}" FontSize="19" VerticalAlignment="Center" Text="☁"/>
              <TextBlock x:Name="WeatherTemp" FontFamily="{DynamicResource DisplayFont}" FontSize="19" Margin="6,0,0,0" VerticalAlignment="Center" Text="--°"/>
            </StackPanel>
            <TextBlock x:Name="WeatherCity" FontSize="10.5" Foreground="{DynamicResource Text3Brush}" HorizontalAlignment="Right" Text="Set location"/>
          </StackPanel>
        </Button>
      </Grid>

      <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,6">
        <!-- System rings -->
        <Button x:Name="SysWidget" Style="{StaticResource Tile}" Height="Auto" Background="{DynamicResource CardBrush}" ToolTip="System">
          <StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
              <Grid Width="38" Height="38" Margin="0,0,6,0">
                <c:RingProgress x:Name="CpuRing" Thickness="4" RingBrush="{DynamicResource AccentBrush}"/>
                <TextBlock x:Name="CpuText" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Grid>
              <Grid Width="38" Height="38">
                <c:RingProgress x:Name="RamRing" Thickness="4" RingBrush="{DynamicResource CyanBrush}"/>
                <TextBlock x:Name="RamText" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Grid>
            </StackPanel>
            <TextBlock Text="CPU · RAM" FontSize="10.5" Foreground="{DynamicResource Text2Brush}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
          </StackPanel>
        </Button>
        <!-- Focus -->
        <Button x:Name="FocusWidget" Style="{StaticResource Tile}" Height="Auto" Background="{DynamicResource CardBrush}" ToolTip="Click: start / pause Pomodoro">
          <StackPanel>
            <TextBlock x:Name="FocusTime" FontFamily="{DynamicResource DisplayFont}" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center"
                       Typography.NumeralAlignment="Tabular" Text="25:00"/>
            <TextBlock x:Name="FocusLabel" FontSize="10.5" Foreground="{DynamicResource Text2Brush}" HorizontalAlignment="Center" Text="Focus"/>
            <TextBlock x:Name="FocusGlyph" Style="{StaticResource Icon}" FontSize="12" Margin="0,5,0,0" Foreground="{DynamicResource AccentBrush}" Text="&#xE768;"/>
          </StackPanel>
        </Button>
        <!-- Screen time -->
        <Button x:Name="ScreenWidget" Style="{StaticResource Tile}" Height="Auto" Background="{DynamicResource CardBrush}" ToolTip="Screen Time">
          <StackPanel>
            <TextBlock x:Name="ScreenTotal" FontFamily="{DynamicResource DisplayFont}" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" Text="0m"/>
            <TextBlock FontSize="10.5" Foreground="{DynamicResource Text2Brush}" HorizontalAlignment="Center" Text="Screen time"/>
            <TextBlock x:Name="ScreenTop" FontSize="10.5" Foreground="{DynamicResource Text3Brush}" HorizontalAlignment="Center" Margin="0,4,0,0"
                       TextTrimming="CharacterEllipsis" MaxWidth="90"/>
          </StackPanel>
        </Button>
      </UniformGrid>

      <Border Grid.Row="2" Background="{DynamicResource CardBrush}" CornerRadius="16" Padding="10,8" Margin="3,0,3,0">
        <StackPanel>
          <UniformGrid Columns="5" Margin="0,0,0,6">
            <ToggleButton x:Name="AwakeTile" Style="{StaticResource TileToggle}" Height="34" Margin="2" ToolTip="Keep awake — stop the PC and screen sleeping">
              <TextBlock Style="{StaticResource Icon}" Text="&#xEA80;" FontSize="14"/>
            </ToggleButton>
            <ToggleButton x:Name="MuteTile" Style="{StaticResource TileToggle}" Height="34" Margin="2" ToolTip="Mute speakers">
              <TextBlock Style="{StaticResource Icon}" Text="&#xE74F;" FontSize="14"/>
            </ToggleButton>
            <ToggleButton x:Name="MicTile" Style="{StaticResource TileToggle}" Height="34" Margin="2" ToolTip="Mute microphone">
              <TextBlock Style="{StaticResource Icon}" Text="&#xE720;" FontSize="14"/>
            </ToggleButton>
            <Button x:Name="SnipTile" Style="{StaticResource Tile}" Height="34" Margin="2" ToolTip="Screenshot (Snipping Tool)">
              <TextBlock Style="{StaticResource Icon}" Text="&#xE8C6;" FontSize="14"/>
            </Button>
            <Button x:Name="LockTile" Style="{StaticResource Tile}" Height="34" Margin="2" ToolTip="Lock PC">
              <TextBlock Style="{StaticResource Icon}" Text="&#xE72E;" FontSize="14"/>
            </Button>
          </UniformGrid>
          <Grid Margin="4,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="24"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="30"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="VolGlyph" Style="{StaticResource Icon}" Text="&#xE995;" FontSize="13" HorizontalAlignment="Left"/>
            <Slider x:Name="VolSlider" Grid.Column="1" Style="{StaticResource Thin}" Minimum="0" Maximum="100"/>
            <TextBlock x:Name="VolText" Grid.Column="2" Style="{StaticResource Num}" FontSize="11" Foreground="{DynamicResource Text2Brush}"
                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
          </Grid>
          <Grid x:Name="BriRow" Margin="4,2,4,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="24"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="30"/>
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource Icon}" Text="&#xE706;" FontSize="13" HorizontalAlignment="Left"/>
            <Slider x:Name="BriSlider" Grid.Column="1" Style="{StaticResource Thin}" Minimum="0" Maximum="100"/>
            <TextBlock x:Name="BriText" Grid.Column="2" Style="{StaticResource Num}" FontSize="11" Foreground="{DynamicResource Text2Brush}"
                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
          </Grid>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>

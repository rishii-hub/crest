<UserControl x:Class="Crest.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="1.25*"/>
      <ColumnDefinition Width="12"/>
      <ColumnDefinition Width="1*"/>
    </Grid.ColumnDefinitions>

    <!-- Now playing -->
    <Border Style="{StaticResource Card}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Grid Width="104" Height="104">
            <Border x:Name="ArtGlow" CornerRadius="16" Opacity="0.55" Margin="6,10,6,0">
              <Border.Effect>
                <BlurEffect Radius="18"/>
              </Border.Effect>
            </Border>
            <Border x:Name="ArtBox" CornerRadius="16" Background="{StaticResource Card2Brush}">
              <TextBlock x:Name="ArtPlaceholder" Style="{StaticResource Icon}" Text="&#xE8D6;" FontSize="34" Foreground="{StaticResource Text3Brush}"/>
            </Border>
          </Grid>
          <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
            <TextBlock x:Name="AppText" FontSize="11" Foreground="{StaticResource Text3Brush}" Text="NOW PLAYING"/>
            <TextBlock x:Name="TitleText" FontSize="18" FontWeight="SemiBold" FontFamily="{StaticResource DisplayFont}"
                       TextTrimming="CharacterEllipsis" Margin="0,4,0,0" Text="Nothing playing"/>
            <TextBlock x:Name="ArtistText" FontSize="13" Foreground="{StaticResource Text2Brush}" TextTrimming="CharacterEllipsis"
                       Margin="0,3,0,0" Text="Play something in Spotify, a browser or any media app"/>
          </StackPanel>
        </Grid>

        <Grid x:Name="SeekRow" Grid.Row="2" Margin="0,8,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="40"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="40"/>
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="PosText" Style="{StaticResource Num}" FontSize="11" Foreground="{StaticResource Text3Brush}" VerticalAlignment="Center" Text="0:00"/>
          <Slider x:Name="SeekSlider" Grid.Column="1" Style="{StaticResource Thin}" Minimum="0" Maximum="1" Margin="4,0"/>
          <TextBlock x:Name="DurText" Grid.Column="2" Style="{StaticResource Num}" FontSize="11" Foreground="{StaticResource Text3Brush}"
                     VerticalAlignment="Center" HorizontalAlignment="Right" Text="0:00"/>
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
          <Button x:Name="PrevBtn" Style="{StaticResource IconButton}" Width="42" Height="42" FontSize="17" Content="&#xE892;"/>
          <Button x:Name="PlayBtn" Style="{StaticResource PrimaryButton}" Margin="14,0" Content="&#xE768;"/>
          <Button x:Name="NextBtn" Style="{StaticResource IconButton}" Width="42" Height="42" FontSize="17" Content="&#xE893;"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Right column -->
    <Grid Grid.Column="2">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <Grid Margin="4,0,4,0">
        <StackPanel>
          <TextBlock x:Name="ClockText" FontFamily="{StaticResource DisplayFont}" FontSize="38" FontWeight="Light" Text="00:00"
                     Typography.NumeralAlignment="Tabular"/>
          <TextBlock x:Name="DateText" FontSize="12.5" Foreground="{StaticResource Text2Brush}" Margin="1,-2,0,0"/>
        </StackPanel>
        <Button x:Name="WeatherMini" Style="{StaticResource Pill}" Background="Transparent" HorizontalAlignment="Right" VerticalAlignment="Top"
                Padding="8,4" ToolTip="Weather">
          <StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <TextBlock x:Name="WeatherSymbol" FontFamily="{StaticResource EmojiFont}" FontSize="20" VerticalAlignment="Center" Text="☁"/>
              <TextBlock x:Name="WeatherTemp" FontFamily="{StaticResource DisplayFont}" FontSize="20" Margin="6,0,0,0" VerticalAlignment="Center" Text="--°"/>
            </StackPanel>
            <TextBlock x:Name="WeatherCity" FontSize="11" Foreground="{StaticResource Text3Brush}" HorizontalAlignment="Right" Text="Set location"/>
          </StackPanel>
        </Button>
      </Grid>

      <UniformGrid Grid.Row="1" Columns="5" Margin="0,10,0,0">
        <ToggleButton x:Name="AwakeTile" Style="{StaticResource TileToggle}" ToolTip="Keep the PC and screen awake">
          <StackPanel>
            <TextBlock Style="{StaticResource Icon}" Text="&#xEA80;" FontSize="16"/>
            <TextBlock Text="Awake" FontSize="10.5" Margin="0,4,0,0" HorizontalAlignment="Center"/>
          </StackPanel>
        </ToggleButton>
        <ToggleButton x:Name="MuteTile" Style="{StaticResource TileToggle}" ToolTip="Mute speakers">
          <StackPanel>
            <TextBlock Style="{StaticResource Icon}" Text="&#xE74F;" FontSize="16"/>
            <TextBlock Text="Mute" FontSize="10.5" Margin="0,4,0,0" HorizontalAlignment="Center"/>
          </StackPanel>
        </ToggleButton>
        <ToggleButton x:Name="MicTile" Style="{StaticResource TileToggle}" ToolTip="Mute microphone">
          <StackPanel>
            <TextBlock Style="{StaticResource Icon}" Text="&#xE720;" FontSize="16"/>
            <TextBlock Text="Mic off" FontSize="10.5" Margin="0,4,0,0" HorizontalAlignment="Center"/>
          </StackPanel>
        </ToggleButton>
        <Button x:Name="SnipTile" Style="{StaticResource Tile}" ToolTip="Screenshot (Snipping Tool)">
          <StackPanel>
            <TextBlock Style="{StaticResource Icon}" Text="&#xE8C6;" FontSize="16"/>
            <TextBlock Text="Snip" FontSize="10.5" Margin="0,4,0,0" HorizontalAlignment="Center"/>
          </StackPanel>
        </Button>
        <Button x:Name="LockTile" Style="{StaticResource Tile}" ToolTip="Lock PC">
          <StackPanel>
            <TextBlock Style="{StaticResource Icon}" Text="&#xE72E;" FontSize="16"/>
            <TextBlock Text="Lock" FontSize="10.5" Margin="0,4,0,0" HorizontalAlignment="Center"/>
          </StackPanel>
        </Button>
      </UniformGrid>

      <Grid Grid.Row="3" Margin="6,6,6,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="26"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="34"/>
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="VolGlyph" Style="{StaticResource Icon}" Text="&#xE995;" FontSize="14" HorizontalAlignment="Left"/>
        <Slider x:Name="VolSlider" Grid.Column="1" Style="{StaticResource Thin}" Minimum="0" Maximum="100"/>
        <TextBlock x:Name="VolText" Grid.Column="2" Style="{StaticResource Num}" FontSize="11.5" Foreground="{StaticResource Text2Brush}"
                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
      </Grid>
      <Grid x:Name="BriRow" Grid.Row="4" Margin="6,6,6,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="26"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="34"/>
        </Grid.ColumnDefinitions>
        <TextBlock Style="{StaticResource Icon}" Text="&#xE706;" FontSize="14" HorizontalAlignment="Left"/>
        <Slider x:Name="BriSlider" Grid.Column="1" Style="{StaticResource Thin}" Minimum="0" Maximum="100"/>
        <TextBlock x:Name="BriText" Grid.Column="2" Style="{StaticResource Num}" FontSize="11.5" Foreground="{StaticResource Text2Brush}"
                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
      </Grid>
    </Grid>
  </Grid>
</UserControl>

<UserControl x:Class="Crest.Views.TimersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Crest.Controls">
  <UserControl.Resources>
    <Style x:Key="ModeCard" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Margin" Value="0,0,0,4"/>
      <Setter Property="GroupName" Value="timer-modes"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Grid>
              <Border x:Name="Bd" CornerRadius="14" Background="Transparent"/>
              <Border x:Name="Ov" CornerRadius="14" Background="{DynamicResource OverlayBrush}" Opacity="0"/>
              <ContentPresenter Margin="12,7"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Ov" Property="Opacity" Value="0.05"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Card2Brush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="200"/>
      <ColumnDefinition Width="210"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- Modes -->
    <StackPanel x:Name="Modes">
      <RadioButton x:Name="PomoMode" Style="{StaticResource ModeCard}" IsChecked="True">
        <StackPanel Orientation="Horizontal">
          <TextBlock Style="{StaticResource Icon}" Text="&#xE916;" FontSize="16" Width="22"/>
          <StackPanel Margin="10,0,0,0">
            <TextBlock Text="Pomodoro" FontSize="13" FontWeight="SemiBold"/>
            <TextBlock x:Name="PomoSub" FontSize="11.5" Foreground="{DynamicResource Text2Brush}" Typography.NumeralAlignment="Tabular"/>
          </StackPanel>
        </StackPanel>
      </RadioButton>
      <RadioButton x:Name="CdMode" Style="{StaticResource ModeCard}">
        <StackPanel Orientation="Horizontal">
          <TextBlock FontFamily="{StaticResource EmojiFont}" Text="⏳" FontSize="15" Width="22" TextAlignment="Center"/>
          <StackPanel Margin="10,0,0,0">
            <TextBlock Text="Countdown" FontSize="13" FontWeight="SemiBold"/>
            <TextBlock x:Name="CdSub" FontSize="11.5" Foreground="{DynamicResource Text2Brush}" Typography.NumeralAlignment="Tabular"/>
          </StackPanel>
        </StackPanel>
      </RadioButton>
      <RadioButton x:Name="SwMode" Style="{StaticResource ModeCard}">
        <StackPanel Orientation="Horizontal">
          <TextBlock FontFamily="{StaticResource EmojiFont}" Text="⏱" FontSize="15" Width="22" TextAlignment="Center"/>
          <StackPanel Margin="10,0,0,0">
            <TextBlock Text="Stopwatch" FontSize="13" FontWeight="SemiBold"/>
            <TextBlock x:Name="SwSub" FontSize="11.5" Foreground="{DynamicResource Text2Brush}" Typography.NumeralAlignment="Tabular"/>
          </StackPanel>
        </StackPanel>
      </RadioButton>
      <RadioButton x:Name="WaterMode" Style="{StaticResource ModeCard}">
        <StackPanel Orientation="Horizontal">
          <TextBlock FontFamily="{StaticResource EmojiFont}" Text="💧" FontSize="15" Width="22" TextAlignment="Center"/>
          <StackPanel Margin="10,0,0,0">
            <TextBlock Text="Water" FontSize="13" FontWeight="SemiBold"/>
            <TextBlock x:Name="WaterSub" FontSize="11.5" Foreground="{DynamicResource Text2Brush}"/>
          </StackPanel>
        </StackPanel>
      </RadioButton>
      <RadioButton x:Name="AlarmMode" Style="{StaticResource ModeCard}">
        <StackPanel Orientation="Horizontal">
          <TextBlock FontFamily="{StaticResource EmojiFont}" Text="⏰" FontSize="15" Width="22" TextAlignment="Center"/>
          <StackPanel Margin="10,0,0,0">
            <TextBlock Text="Alarms" FontSize="13" FontWeight="SemiBold"/>
            <TextBlock x:Name="AlarmSub" FontSize="11.5" Foreground="{DynamicResource Text2Brush}" Typography.NumeralAlignment="Tabular"/>
          </StackPanel>
        </StackPanel>
      </RadioButton>
    </StackPanel>

    <!-- Ring -->
    <Grid Grid.Column="1" Width="196" Height="196" VerticalAlignment="Center" HorizontalAlignment="Center">
      <c:RingProgress x:Name="Ring" Thickness="7" RingBrush="{DynamicResource AccentBrush}"/>
      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
        <TextBlock x:Name="BigTime" FontFamily="{DynamicResource DisplayFont}" FontSize="42" FontWeight="SemiBold"
                   Typography.NumeralAlignment="Tabular" HorizontalAlignment="Center" Text="25:00"/>
        <TextBlock x:Name="BigLabel" FontSize="12.5" Foreground="{DynamicResource Text2Brush}" HorizontalAlignment="Center" Text="Focus"/>
      </StackPanel>
    </Grid>

    <!-- Controls (built in code) -->
    <Grid Grid.Column="2" Margin="10,0,0,0">
      <StackPanel x:Name="PomoPanel" VerticalAlignment="Center"/>
      <StackPanel x:Name="CdPanel" VerticalAlignment="Center" Visibility="Collapsed"/>
      <Grid x:Name="SwPanel" Visibility="Collapsed"/>
      <StackPanel x:Name="WaterPanel" VerticalAlignment="Center" Visibility="Collapsed"/>
      <DockPanel x:Name="AlarmPanel" Visibility="Collapsed"/>
    </Grid>
  </Grid>
</UserControl>

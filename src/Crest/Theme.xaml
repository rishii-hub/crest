<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Palette (Apple dark system colors) -->
  <SolidColorBrush x:Key="AccentBrush" Color="#FFFF9F0A"/>
  <SolidColorBrush x:Key="CardBrush" Color="#FF161618"/>
  <SolidColorBrush x:Key="Card2Brush" Color="#FF242426"/>
  <SolidColorBrush x:Key="HoverBrush" Color="#FF333336"/>
  <SolidColorBrush x:Key="StrokeBrush" Color="#FF2E2E31"/>
  <SolidColorBrush x:Key="TextBrush" Color="#FFF5F5F7"/>
  <SolidColorBrush x:Key="Text2Brush" Color="#FFA1A1A6"/>
  <SolidColorBrush x:Key="Text3Brush" Color="#FF6E6E73"/>
  <SolidColorBrush x:Key="GreenBrush" Color="#FF30D158"/>
  <SolidColorBrush x:Key="RedBrush" Color="#FFFF453A"/>
  <SolidColorBrush x:Key="BlueBrush" Color="#FF0A84FF"/>
  <SolidColorBrush x:Key="OrangeBrush" Color="#FFFF9F0A"/>
  <SolidColorBrush x:Key="CyanBrush" Color="#FF64D2FF"/>
  <SolidColorBrush x:Key="PurpleBrush" Color="#FFBF5AF2"/>
  <!-- Theme roles (ThemeService replaces these at runtime) -->
  <SolidColorBrush x:Key="PanelBrush" Color="#FF000000"/>
  <SolidColorBrush x:Key="DockBrush" Color="#FF161618"/>
  <SolidColorBrush x:Key="InkBrush" Color="#FFFFFFFF"/>
  <SolidColorBrush x:Key="OnInkBrush" Color="#FF000000"/>
  <SolidColorBrush x:Key="OverlayBrush" Color="#FFFFFFFF"/>
  <SolidColorBrush x:Key="DividerBrush" Color="#33FFFFFF"/>
  <SolidColorBrush x:Key="TrackBrush" Color="#FF39393D"/>
  <SolidColorBrush x:Key="ScrollBrush" Color="#40FFFFFF"/>

  <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
  <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
  <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
  <FontFamily x:Key="EmojiFont">Segoe UI Emoji, Segoe UI Symbol</FontFamily>

  <!-- Text -->
  <Style x:Key="Icon" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
    <Setter Property="FontSize" Value="15"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style x:Key="H1" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}"/>
    <Setter Property="FontSize" Value="15"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style x:Key="Caption" TargetType="TextBlock">
    <Setter Property="FontSize" Value="11.5"/>
    <Setter Property="Foreground" Value="{DynamicResource Text2Brush}"/>
  </Style>
  <Style x:Key="Num" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}"/>
    <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
  </Style>

  <!-- Card -->
  <Style x:Key="Card" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
    <Setter Property="CornerRadius" Value="18"/>
    <Setter Property="Padding" Value="14"/>
  </Style>

  <!-- Icon button (round, hover overlay) -->
  <Style x:Key="IconButton" TargetType="ButtonBase">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Width" Value="32"/>
    <Setter Property="Height" Value="32"/>
    <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ButtonBase">
          <Grid>
            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="10"/>
            <Border x:Name="Ov" Background="{DynamicResource OverlayBrush}" Opacity="0" CornerRadius="10"/>
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                              TextElement.Foreground="{TemplateBinding Foreground}"
                              TextElement.FontFamily="{TemplateBinding FontFamily}"
                              TextElement.FontSize="{TemplateBinding FontSize}"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Ov" Property="Opacity" Value="0.09"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Ov" Property="Opacity" Value="0.16"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.35"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Toggle icon button: accent when checked -->
  <Style x:Key="IconToggle" TargetType="ToggleButton" BasedOn="{StaticResource IconButton}">
    <Style.Triggers>
      <Trigger Property="IsChecked" Value="True">
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- Dock tab: the white selection pill is a separate element that slides between tabs -->
  <Style x:Key="TabButton" TargetType="RadioButton">
    <Setter Property="Foreground" Value="{DynamicResource Text2Brush}"/>
    <Setter Property="Width" Value="36"/>
    <Setter Property="Height" Value="36"/>
    <Setter Property="Margin" Value="1,0"/>
    <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
    <Setter Property="FontSize" Value="15"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Grid Background="Transparent">
            <Ellipse x:Name="Ov" Fill="{DynamicResource OverlayBrush}" Opacity="0"/>
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                              TextElement.Foreground="{TemplateBinding Foreground}"
                              TextElement.FontFamily="{TemplateBinding FontFamily}"
                              TextElement.FontSize="{TemplateBinding FontSize}"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Ov" Property="Opacity" Value="0.08"/>
              <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Ov" Property="Opacity" Value="0"/>
              <Setter Property="Foreground" Value="{DynamicResource OnInkBrush}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Segmented control item -->
  <Style x:Key="Seg" TargetType="RadioButton">
    <Setter Property="Foreground" Value="{DynamicResource Text2Brush}"/>
    <Setter Property="Padding" Value="12,5"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                              TextElement.Foreground="{TemplateBinding Foreground}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
              <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Pill button -->
  <Style x:Key="Pill" TargetType="ButtonBase">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    <Setter Property="Background" Value="{DynamicResource Card2Brush}"/>
    <Setter Property="Padding" Value="12,6"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ButtonBase">
          <Grid>
            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="10"/>
            <Border x:Name="Ov" Background="{DynamicResource OverlayBrush}" Opacity="0" CornerRadius="10"/>
            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"
                              TextElement.Foreground="{TemplateBinding Foreground}"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Ov" Property="Opacity" Value="0.08"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Ov" Property="Opacity" Value="0.15"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="PillToggle" TargetType="ToggleButton" BasedOn="{StaticResource Pill}">
    <Style.Triggers>
      <Trigger Property="IsChecked" Value="True">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="Foreground" Value="Black"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- Big round primary button (play/pause) -->
  <Style x:Key="PrimaryButton" TargetType="ButtonBase">
    <Setter Property="Foreground" Value="{DynamicResource OnInkBrush}"/>
    <Setter Property="Background" Value="{DynamicResource InkBrush}"/>
    <Setter Property="Width" Value="44"/>
    <Setter Property="Height" Value="44"/>
    <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
    <Setter Property="FontSize" Value="17"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ButtonBase">
          <Grid>
            <Ellipse x:Name="Bd" Fill="{TemplateBinding Background}"/>
            <Ellipse x:Name="Ov" Fill="Black" Opacity="0"/>
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                              TextElement.Foreground="{TemplateBinding Foreground}"
                              TextElement.FontFamily="{TemplateBinding FontFamily}"
                              TextElement.FontSize="{TemplateBinding FontSize}"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Ov" Property="Opacity" Value="0.08"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Ov" Property="Opacity" Value="0.18"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Quick-action tiles -->
  <Style x:Key="Tile" TargetType="ButtonBase">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    <Setter Property="Background" Value="{DynamicResource Card2Brush}"/>
    <Setter Property="Height" Value="58"/>
    <Setter Property="Margin" Value="3"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ButtonBase">
          <Grid>
            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="14"/>
            <Border x:Name="Ov" Background="{DynamicResource OverlayBrush}" Opacity="0" CornerRadius="14"/>
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                              TextElement.Foreground="{TemplateBinding Foreground}"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Ov" Property="Opacity" Value="0.08"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Ov" Property="Opacity" Value="0.15"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="TileToggle" TargetType="ToggleButton" BasedOn="{StaticResource Tile}">
    <Style.Triggers>
      <Trigger Property="IsChecked" Value="True">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="Foreground" Value="Black"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- iOS-style switch -->
  <Style x:Key="Switch" TargetType="CheckBox">
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <Border x:Name="Track" Width="40" Height="24" CornerRadius="12" Background="{DynamicResource TrackBrush}">
            <Ellipse x:Name="Knob" Width="20" Height="20" Fill="White" HorizontalAlignment="Left" Margin="2,0,0,0"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentBrush}"/>
              <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
              <Setter TargetName="Knob" Property="Margin" Value="0,0,2,0"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Round checkbox for to-dos -->
  <Style x:Key="Check" TargetType="CheckBox">
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <Grid Width="18" Height="18">
            <Ellipse x:Name="Ring" Stroke="{DynamicResource Text3Brush}" StrokeThickness="1.5" Fill="Transparent"/>
            <TextBlock x:Name="Tick" Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="10" Foreground="Black"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Ring" Property="Fill" Value="{DynamicResource AccentBrush}"/>
              <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource AccentBrush}"/>
              <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Slider: thin track, fill uses the slider's Foreground -->
  <Style x:Key="SliderRepeatFill" TargetType="RepeatButton">
    <Setter Property="OverridesDefaultStyle" Value="True"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="IsTabStop" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RepeatButton">
          <Grid Background="Transparent">
            <Border Height="4" CornerRadius="2" VerticalAlignment="Center"
                    Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Slider}}"/>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="SliderRepeatBlank" TargetType="RepeatButton">
    <Setter Property="OverridesDefaultStyle" Value="True"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="IsTabStop" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RepeatButton">
          <Grid Background="Transparent"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="SliderThumb" TargetType="Thumb">
    <Setter Property="OverridesDefaultStyle" Value="True"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Ellipse x:Name="E" Width="12" Height="12" Fill="{DynamicResource InkBrush}"/>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="E" Property="Width" Value="14"/>
              <Setter TargetName="E" Property="Height" Value="14"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="Thin" TargetType="Slider">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="IsMoveToPointEnabled" Value="True"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Slider">
          <Grid Height="18" Background="Transparent">
            <Border Height="4" CornerRadius="2" Background="{DynamicResource TrackBrush}" VerticalAlignment="Center"/>
            <Track x:Name="PART_Track">
              <Track.DecreaseRepeatButton>
                <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource SliderRepeatFill}"/>
              </Track.DecreaseRepeatButton>
              <Track.IncreaseRepeatButton>
                <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource SliderRepeatBlank}"/>
              </Track.IncreaseRepeatButton>
              <Track.Thumb>
                <Thumb Style="{StaticResource SliderThumb}"/>
              </Track.Thumb>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Text field with placeholder (Tag) -->
  <Style x:Key="Field" TargetType="TextBox">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    <Setter Property="Background" Value="{DynamicResource Card2Brush}"/>
    <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}"/>
    <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="10,7"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
            <Grid>
              <TextBlock x:Name="Hint" Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                         Foreground="{DynamicResource Text3Brush}" IsHitTestVisible="False" Visibility="Collapsed"
                         Margin="2,0,0,0" TextWrapping="Wrap"/>
              <ScrollViewer x:Name="PART_ContentHost" Focusable="False" VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}"/>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="Text" Value="">
              <Setter TargetName="Hint" Property="Visibility" Value="Visible"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="PasswordField" TargetType="PasswordBox">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
    <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="10,7"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="ToolTip" Value="API key (stored encrypted for your Windows account). Leave empty to keep the saved key."/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="PasswordBox">
          <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
            <ScrollViewer x:Name="PART_ContentHost" Focusable="False"/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Slim scrollbars everywhere -->
  <ControlTemplate x:Key="VScroll" TargetType="ScrollBar">
    <Track x:Name="PART_Track" IsDirectionReversed="True">
      <Track.Thumb>
        <Thumb>
          <Thumb.Template>
            <ControlTemplate TargetType="Thumb">
              <Border CornerRadius="3" Background="{DynamicResource ScrollBrush}"/>
            </ControlTemplate>
          </Thumb.Template>
        </Thumb>
      </Track.Thumb>
    </Track>
  </ControlTemplate>
  <ControlTemplate x:Key="HScroll" TargetType="ScrollBar">
    <Track x:Name="PART_Track" IsDirectionReversed="False">
      <Track.Thumb>
        <Thumb>
          <Thumb.Template>
            <ControlTemplate TargetType="Thumb">
              <Border CornerRadius="3" Background="{DynamicResource ScrollBrush}"/>
            </ControlTemplate>
          </Thumb.Template>
        </Thumb>
      </Track.Thumb>
    </Track>
  </ControlTemplate>
  <Style TargetType="ScrollBar">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Width" Value="5"/>
    <Setter Property="MinWidth" Value="5"/>
    <Setter Property="Template" Value="{StaticResource VScroll}"/>
    <Style.Triggers>
      <Trigger Property="Orientation" Value="Horizontal">
        <Setter Property="Width" Value="Auto"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="Height" Value="5"/>
        <Setter Property="MinHeight" Value="5"/>
        <Setter Property="Template" Value="{StaticResource HScroll}"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- Touch / pen: pan scroll views with a finger -->
  <Style TargetType="ScrollViewer">
    <Setter Property="PanningMode" Value="VerticalFirst"/>
    <Setter Property="PanningDeceleration" Value="0.003"/>
  </Style>

  <Style TargetType="ToolTip">
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToolTip">
          <Border Background="#FF2C2C2E" CornerRadius="7" Padding="9,5">
            <ContentPresenter TextElement.Foreground="White"/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
